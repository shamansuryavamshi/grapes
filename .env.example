# Copy to .env and edit. All values are optional; the defaults in
# iwnet/config.py apply when a variable is unset.

# ── API server ──────────────────────────────────────────────────────────────
# Keep this on 127.0.0.1 unless the server sits behind a real reverse proxy.
# 0.0.0.0 exposes an unauthenticated inference endpoint to your network.
IWNET_HOST=127.0.0.1
IWNET_PORT=8000

# Reject oversized uploads before decoding them (bytes). Default 10 MB.
IWNET_MAX_UPLOAD_BYTES=10485760

# Comma-separated origins allowed to call the API from a browser. Empty means
# same-origin only, which is correct for the bundled web UI.
IWNET_CORS_ORIGINS=

# ── Inference ───────────────────────────────────────────────────────────────
# Device override: cpu, cuda, cuda:0, mps. Leave unset to auto-detect.
IWNET_DEVICE=

# ── Logging ─────────────────────────────────────────────────────────────────
IWNET_LOG_LEVEL=INFO
